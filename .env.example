# =============================================================================
# RBIG Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud Platform (Required)
# -----------------------------------------------------------------------------

# Your GCP Project ID (required)
GOOGLE_CLOUD_PROJECT=your-project-id

# GCP Region for Vertex AI (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# Path to service account key file (optional if using ADC)
# If not set, Application Default Credentials (ADC) will be used
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Port for the dashboard server (default: 3000)
PORT=3000

# Master aesthetic prompt prepended to all generation requests
# This ensures visual consistency across all generated images
MASTER_AESTHETIC_PROMPT=High-quality, photorealistic image with cinematic lighting. Sharp focus, professional photography, 8K resolution.

# -----------------------------------------------------------------------------
# Resilience Configuration
# -----------------------------------------------------------------------------

# Maximum retry attempts for failed jobs (default: 3)
MAX_RETRIES=3

# Delay between API calls in milliseconds (rate limiting) (default: 2000)
RATE_LIMIT_MS=2000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info
