{
  "name": "resilient-batch-image-generator",
  "version": "2.1.0",
  "description": "Fault-tolerant batch image generator using Google Vertex AI Imagen 3 with real-time observability dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "yarn build && node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "benchmark": "tsx --env-file=.env src/benchmark/index.ts"
  },
  "keywords": [
    "vertex-ai",
    "imagen-3",
    "batch-processing",
    "image-generation",
    "fault-tolerant",
    "gcp",
    "typescript"
  ],
  "author": "Santiago Torres",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@google-cloud/aiplatform": "^3.27.0",
    "@google-cloud/service-usage": "^4.2.1",
    "@google/genai": "^1.34.0",
    "fastify": "^5.2.0",
    "openai": "^6.15.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
