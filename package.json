{
  "name": "resilient-batch-image-generator",
  "version": "2.1.0",
  "description": "Fault-tolerant batch image generator using Google Vertex AI Imagen 3 with real-time observability dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "yarn build && node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vertex-ai",
    "imagen-3",
    "batch-processing",
    "image-generation",
    "fault-tolerant",
    "gcp",
    "typescript"
  ],
  "author": "Santiago Torres",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@google-cloud/aiplatform": "^3.27.0",
    "@google-cloud/service-usage": "^4.2.1",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
